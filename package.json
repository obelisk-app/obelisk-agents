{
  "name": "obelisk-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Nostr bots and LLM agents for the Obelisk ecosystem (NIP-29 groups). Each bot is a single Node script with its own nsec; PM2 keeps them running.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "price-bot": "node --env-file-if-exists=.env.local bots/price-bot.mjs",
    "price-bot:cleanup": "node --env-file-if-exists=.env.local bots/price-bot.cleanup.mjs",
    "zap-bot": "node --env-file-if-exists=.env.local bots/zap-bot.mjs",
    "new-bot": "node tools/new-bot.mjs",
    "whoami": "node --env-file-if-exists=.env.local tools/whoami.mjs",
    "set-profile": "node --env-file-if-exists=.env.local tools/set-profile.mjs",
    "grant-admin": "node --env-file-if-exists=.env.local tools/grant-admin.mjs",
    "add-member": "node --env-file-if-exists=.env.local tools/add-member.mjs",
    "list-groups": "node tools/list-groups.mjs",
    "manager": "node --env-file-if-exists=.env.local server/index.mjs",
    "frontend:build": "cd frontend && npm install && npm run build",
    "pm2:start": "pm2 start ecosystem.config.cjs && pm2 save",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "nostr-tools": "^2.7.2",
    "ws": "^8.18.0"
  }
}
