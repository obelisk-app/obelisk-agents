# Obelisk bots — environment template.
# Copy to .env.local (gitignored) and fill in.
# `npm run <script>` automatically reads .env.local via Node's --env-file-if-exists.

# ── Identity (one nsec per bot — never share) ─────────────────────────
# nsec1... or 64-char hex. Generate with: npm run new-bot <name>
BOT_NSEC=

# ── Profile ticker (price-bot, also used by tools/set-profile.mjs) ────
# Comma-separated relay URLs where kind:0 metadata is broadcast.
BOT_RELAYS=wss://public.obelisk.ar,wss://relay.damus.io,wss://relay.nostr.band,wss://nos.lol

# ── Group memberships (price-bot, grant-admin, add-member targets) ────
# Comma-separated `relayUrl|groupId` pairs.
# Discover groupIds with: npm run list-groups -- wss://public.obelisk.ar
BOT_GROUPS=

# ── Price-bot tuning ──────────────────────────────────────────────────
# Refresh interval in ms (CoinGecko allows ~10/min on the free tier).
BOT_INTERVAL_MS=120000
# kind:0 display-name template; ${price} is interpolated with comma-formatted USD.
BOT_DISPLAY=BTC ${price}
# >0 publishes a kind 9 summary every N price-change ticks; 0 disables.
BOT_CHAT_EVERY_N_TICKS=0

# ── sat-ars-bot (satoshi → Argentine peso) ────────────────────────────
# Each bot must have its own nsec — otherwise multiple bots fight over kind:0.
# SAT_ARS_BOT_NSEC=
# SAT_ARS_BOT_RELAYS=wss://public.obelisk.ar,wss://relay.damus.io,wss://nos.lol
# SAT_ARS_BOT_GROUPS=
# SAT_ARS_BOT_INTERVAL_MS=60000
# SAT_ARS_BOT_DISPLAY=sat ${price} ARS
# SAT_ARS_BOT_CHAT_EVERY_N_TICKS=0

# ── zap-bot (announces group zaps) ────────────────────────────────────
# Listens for kind 7 ⚡ reactions and kind 9735 receipts in each
# configured group, then posts a kind 9 like
# "⚡ @alice sent 420 satoshis to @bob".
# ZAP_BOT_NSEC=
# ZAP_BOT_RELAYS=wss://public.obelisk.ar,wss://relay.damus.io,wss://relay.nostr.band
# ZAP_BOT_GROUPS=                                # static `relay|groupId` seeds
# ZAP_BOT_LISTEN_RELAYS=                         # relays to scan for kind 39000 and auto-subscribe to every open group
# ZAP_BOT_REFRESH_MS=600000                      # group-discovery refresh cadence
# ZAP_BOT_RECONNECT_MS=10000                     # base reconnect delay (jitter 0..1× added)
# ZAP_BOT_HELLO=1                                # 0 disables the per-group hello kind 9
# ZAP_BOT_HELLO_THROTTLE_MS=4000                 # delay between hellos when joining many groups
# ZAP_BOT_HEARTBEAT_MS=300000                    # alive log cadence
# ZAP_BOT_SEEN_MAX=10000                         # dedup-cache size (FIFO)
# ZAP_BOT_MIN_SATS=1
# ZAP_BOT_TEMPLATE=⚡ ${sender} sent ${amount} ${unit} to ${recipient}

# ── Admin tools (set-profile / grant-admin / add-member) ──────────────
# When the human admin runs grant-admin, this is *their* nsec — not the
# target bot's. Fill in only when invoking the tool, then comment out.
# ADMIN_NSEC=

# Required by grant-admin / add-member: which group + which pubkey.
# TARGET_GROUP=wss://public.obelisk.ar|abcdef0123456789
# TARGET_PUBKEY=          # bot's hex pubkey or npub1...
# TARGET_ROLES=admin      # admin / mod / welcomer / ...

# ── set-profile inputs (override per-invocation) ──────────────────────
# PROFILE_NAME=
# PROFILE_DISPLAY=
# PROFILE_ABOUT=
# PROFILE_PICTURE=
